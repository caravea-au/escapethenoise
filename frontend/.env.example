NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your-api-token-here
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here
# Public base URL uploads are served from when using DigitalOcean Spaces, so
# next/image can load them. Match the backend DO_SPACE_CDN_URL, or the bucket
# origin, e.g. https://nobettertime.syd1.digitaloceanspaces.com
NEXT_PUBLIC_UPLOADS_URL=
# SMTP credentials moved into Strapi → "SMTP Settings" single type (admin-managed).

# ── Caravea Connect ──────────────────────────────────────────────────────────
# NOT NEEDED HERE ANY MORE. /find-dealer reads Strapi, which holds a cache of the
# Connect dealer feed (ETN-013), so CONNECT_API_URL / CONNECT_API_KEY belong in
# backend/.env only. If you set them here they do nothing; the frontend makes no
# requests to Connect at all, and that is verified by grep in the ticket's
# acceptance criteria.
#
# What the page DOES need is a reachable Strapi (NEXT_PUBLIC_STRAPI_URL above).
# Without one it shows its "can't load the dealer directory" panel — there is no
# other source, and deliberately no live-Connect fallback: last-good or nothing.

# DO_SPACE_BUCKET / DO_SPACE_ROOT_PATH are NO LONGER READ HERE either, and have
# been removed for that reason. They pinned which DigitalOcean Space dealer
# logos and photos were allowed to come from — syd1.digitaloceanspaces.com is
# DigitalOcean's SHARED regional endpoint, so host alone would let any Spaces
# customer choose the images on our directory. That check now runs once, in
# Strapi, at sync time (backend/src/utils/trusted-media-url.ts), and an untrusted
# URL is never stored in the first place. Set them in backend/.env only.
#
# next/image still needs the Spaces HOST allow-listed, but that comes from
# NEXT_PUBLIC_UPLOADS_URL above, not from these.

# ── On-demand revalidation (ETN-013) ─────────────────────────────────────────
# Shared secret for POST /api/revalidate, which Strapi calls when a staff member
# publishes or unpublishes a dealer so the change shows on the next page load
# rather than after the 60s cache window. Must match backend/.env's
# REVALIDATE_SECRET exactly. Unset = the route 401s everything, which is the
# correct closed default: the only cost is waiting out the window.
REVALIDATE_SECRET=

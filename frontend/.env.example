NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your-api-token-here
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here
# Public base URL uploads are served from when using DigitalOcean Spaces, so
# next/image can load them. Match the backend DO_SPACE_CDN_URL, or the bucket
# origin, e.g. https://nobettertime.syd1.digitaloceanspaces.com
NEXT_PUBLIC_UPLOADS_URL=
# SMTP credentials moved into Strapi → "SMTP Settings" single type (admin-managed).

# ── Caravea Connect ──────────────────────────────────────────────────────────
# /find-dealer reads its dealers from Connect, not from Strapi. WITHOUT BOTH OF
# THESE THE PAGE SHOWS ITS "can't load the dealer directory" PANEL — there is no
# other source any more. Same values as backend/.env; SERVER-SIDE ONLY, never
# prefix either with NEXT_PUBLIC_ (the key would be inlined into the client
# bundle and readable by anyone).
CONNECT_API_URL=
CONNECT_API_KEY=

# Which DigitalOcean Space dealer logos/photos are allowed to come from. Connect
# hands back media URLs as free-text strings that go straight into an <img src>,
# and syd1.digitaloceanspaces.com is DigitalOcean's SHARED regional endpoint, so
# the bucket and root path are pinned too — host alone would let any Spaces
# customer choose the images on our directory. Must match backend/.env exactly.
# Leave either blank and every dealer image is rejected (visibly, by design).
DO_SPACE_BUCKET=
DO_SPACE_ROOT_PATH=

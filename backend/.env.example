HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
STRAPI_SEED_FALLBACK_CONTENT=false
STRAPI_RANGE_API_URL=
STRAPI_RANGE_API_ENABLED=false
STRAPI_EVENTS_API_URL=
STRAPI_EVENTS_API_ENABLED=false

# Trust X-Forwarded-For from the reverse proxy (nginx in production) so
# ctx.request.ip is the real client IP, not the proxy's. Required for the
# dealer-enquiry rate limit to work per-visitor instead of globally. Only set
# to false for a bare local run with no reverse proxy in front of Strapi.
IS_PROXIED=true

# Email (SMTP) for dealer-submission notifications is no longer configured via
# env. Set it in the Strapi admin → Content Manager → "SMTP Settings" single type.

# DigitalOcean Spaces (S3-compatible) upload storage. Leave DO_SPACE_ENDPOINT
# blank to fall back to local disk uploads (dev without Spaces).
# Endpoint is the REGIONAL host only — no bucket, no path suffix.
#   e.g. https://syd1.digitaloceanspaces.com  (region = syd1)
DO_SPACE_ENDPOINT=https://syd1.digitaloceanspaces.com
DO_SPACE_REGION=syd1
DO_SPACE_BUCKET=media-caravea
# Folder (key prefix) within the bucket this project's uploads live under.
DO_SPACE_ROOT_PATH=nobettertime
DO_SPACE_ACCESS_KEY=
DO_SPACE_SECRET_KEY=
# Optional overrides:
# DO_SPACE_ACL=public-read
# Public CDN/base URL for file links (leave blank to use the endpoint origin).
DO_SPACE_CDN_URL=

# Caravea Connect (inbound dealer-registration forward). Every new
# dealer-submission is best-effort forwarded to Connect's
# /api/public/dealer-registrations endpoint. Unset (either var blank) =
# dormant: isConnectEnabled() requires BOTH, so no outbound request is ever
# made and a dealer submission still saves normally either way.
# Value comes from Caravea Connect's ops team / the Obsidian vault — see
# docs/nobettertime-staging-connect.md for the contract (key redacted there
# on purpose).
CONNECT_API_URL=
CONNECT_API_KEY=

# ── Caravea Connect → Strapi dealer cache (OUTBOUND read, ETN-013) ───────────
# The dealer directory is a CACHE of Connect's feed, filled by a cron sweep and
# read by /find-dealer from Strapi. Reuses CONNECT_API_URL / CONNECT_API_KEY
# above — the same credentials serve the inbound push and this outbound read.
#
# Master switch. Defaults FALSE, so a box with no Connect credentials never
# schedules a sweep that could only fail, and staging/production are independent.
# `true` (lowercase compared) turns it on.
CONNECT_SYNC_ENABLED=false
# Optional cron override. Default is every 10 minutes.
# CONNECT_SYNC_CRON=*/10 * * * *

# Where to tell Next.js to drop its cached dealer list the moment a staff member
# publishes or unpublishes a dealer. Unset = dormant, and the only cost is that
# the toggle takes up to 60s to show instead of appearing on the next page load.
# REVALIDATE_URL is the FRONTEND's origin; the secret must match the frontend's.
REVALIDATE_URL=
REVALIDATE_SECRET=

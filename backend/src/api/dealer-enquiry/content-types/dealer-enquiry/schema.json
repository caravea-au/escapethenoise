{
  "kind": "collectionType",
  "collectionName": "dealer_enquiries",
  "info": {
    "singularName": "dealer-enquiry",
    "pluralName": "dealer-enquiries",
    "displayName": "Dealer Enquiry",
    "description": "Consumer enquiries sent to a dealer from /find-dealer. HOLDS CONSUMER PII (name, email, phone, message) — the `find` and `findOne` actions must NEVER be granted to the Public role. Only `create` (via routes/dealer-enquiry.ts, auth: false) is public."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "dealer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::dealer-submission.dealer-submission"
    },
    "dealerName": { "type": "string" },

    "name": { "type": "string", "required": true },
    "email": { "type": "email", "required": true },
    "message": { "type": "text", "maxLength": 2000, "required": true },
    "phone": { "type": "string" },
    "postcode": { "type": "string" },
    "interest": { "type": "string" },
    "sourcePage": { "type": "string" },

    "submittedAt": { "type": "datetime" },
    "spamSuspect": { "type": "boolean", "default": false },
    "ipHash": { "type": "string", "private": true }
  }
}

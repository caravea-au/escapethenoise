# ============================================================================
# frontend/.env — [ENV] on the Ploi box. Lives at /home/ploi/[frontend-domain]/frontend/.env
# ----------------------------------------------------------------------------
# Written by `/deployment` over SSH. NEVER committed, NEVER pasted into chat.
#
# This file must exist BEFORE the first `npm run build --workspace=frontend`:
# NEXT_PUBLIC_STRAPI_URL is baked into the build (next.config.ts uses it to build
# images.remotePatterns, and layout.tsx uses NEXT_PUBLIC_SITE_URL for metadataBase).
# Building without it ships a bundle whose Strapi images 400 at runtime, and no
# amount of restarting fixes that — it needs a rebuild.
# ============================================================================

NODE_ENV=production

# Must be https end to end: this value also auto-allowlists the CMS host for next/image.
NEXT_PUBLIC_STRAPI_URL=https://[cms-domain]
NEXT_PUBLIC_SITE_URL=https://[frontend-domain]

# Created in the CMS admin AFTER first boot: Settings > API Tokens > custom,
# read-only, scoped. Never "Full access", never unlimited lifespan. Leave blank on
# the very first deploy, then fill it in and `pm2 restart [frontend-pm2] --update-env`.
STRAPI_API_TOKEN=

# Shared secret guarding POST /api/revalidate. Must be byte-identical to the
# backend's REVALIDATE_SECRET, and must not stay as the .env.example placeholder.
REVALIDATE_SECRET=[generate]

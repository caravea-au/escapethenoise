# ============================================================================
# backend/.env — [ENV] on the Ploi box. Lives at /home/ploi/[cms-domain]/backend/.env
# ----------------------------------------------------------------------------
# Written by `/deployment` over SSH. NEVER committed, NEVER pasted into chat or a
# repo file. Mode 600. Generate every secret fresh with `openssl rand -base64 32`
# ON THE SERVER, and use DIFFERENT values for staging and production.
#
# This file is a hard prerequisite of the FIRST backend deploy, not just of
# starting the process: `strapi ts:generate-types` boots Strapi's register phase
# and dies with `Missing admin.auth.secret configuration` without it.
# ============================================================================

HOST=0.0.0.0
PORT=[backend-port]

# --- Secrets (openssl rand -base64 32 each; APP_KEYS is four of them, comma-joined) ---
APP_KEYS=[generate]
API_TOKEN_SALT=[generate]
ADMIN_JWT_SECRET=[generate]
TRANSFER_TOKEN_SALT=[generate]
JWT_SECRET=[generate]
ENCRYPTION_KEY=[generate]

# Public origin of this CMS. Strapi is behind an nginx reverse proxy, so without
# this the admin issues redirects to the internal host and uploaded media comes
# back as relative/http URLs that next/image rejects with a 400.
PUBLIC_URL=https://[cms-domain]

STRAPI_SEED_FALLBACK_CONTENT=false

# --- Database ---------------------------------------------------------------
# Default is SQLite at backend/.tmp/data.db (untracked, so it survives deploys but
# NOT a site re-install; back it up before any transfer). Move off SQLite before a
# site becomes permanent. For Postgres, set DATABASE_CLIENT=postgres and add `pg`
# to backend/package.json first — it is not installed by default.
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_SSL=true

# --- Frontend revalidation --------------------------------------------------
# After a sync/content change Strapi pings the frontend to refresh ISR pages.
# REVALIDATE_SECRET must be byte-identical to the frontend's value, and must NOT
# be left as the .env.example placeholder: the route fails closed and logs only
# "rejected (invalid or missing secret)", so a placeholder looks like silence.
REVALIDATE_URL=https://[frontend-domain]
REVALIDATE_SECRET=[generate]

# --- Caravea Site API (only if this project consumes inventory) --------------
# See the `site-api-inventory-cache` skill. Upstream is rate-limited to 60 req/min
# with per-IP anti-DDoS, and every Caravea site egresses from ONE IP — keep the
# budget low and never enable the cron on more than one environment at a time.
CARAVEA_SITE_API_BASE_URL=https://hub.caravea.au/api/site
CARAVEA_SITE_API_KEY=
CARAVEA_SITE_COMPANY_ID=
INVENTORY_SYNC_ENABLED=false
INVENTORY_SYNC_CRON="*/15 * * * *"
INVENTORY_SYNC_RATE_PER_MIN=20

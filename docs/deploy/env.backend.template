# ============================================================================
# backend/.env — lives at /home/ploi/<cms-domain>/backend/.env
#   staging: /home/ploi/staging-cms.nobettertime.com.au/backend/.env  (PORT=1345)
#   prod:    /home/ploi/cms.nobettertime.com.au/backend/.env          (PORT=1340)
# ----------------------------------------------------------------------------
# Written over SSH by `/deployment`. NEVER committed, NEVER pasted into chat or a
# repo file. Mode 600. Generate every secret fresh with `openssl rand -base64 32`
# ON THE SERVER, and use DIFFERENT values for staging and production.
#
# This file is a hard prerequisite of the FIRST backend deploy, not just of
# starting the process: `strapi ts:generate-types` boots Strapi's register phase
# and dies with `Missing admin.auth.secret configuration` without it.
# ============================================================================

HOST=0.0.0.0
PORT=<1345 staging | 1340 prod>

# --- Secrets (openssl rand -base64 32 each; APP_KEYS is four of them, comma-joined) ---
APP_KEYS=<generate>
API_TOKEN_SALT=<generate>
ADMIN_JWT_SECRET=<generate>
TRANSFER_TOKEN_SALT=<generate>
JWT_SECRET=<generate>
ENCRYPTION_KEY=<generate>

# Trust X-Forwarded-For from nginx so ctx.request.ip is the real visitor, not the
# proxy. Required or the dealer-enquiry rate limit becomes a GLOBAL lockout after
# 5 enquiries from anyone. Strapi reads `server.proxy.koa`, and config/server.ts
# already nests it correctly — this env var only flips it.
IS_PROXIED=true

STRAPI_SEED_FALLBACK_CONTENT=false

# --- Upstream range/events feeds (off unless this environment needs them) -----
STRAPI_RANGE_API_URL=
STRAPI_RANGE_API_ENABLED=false
STRAPI_EVENTS_API_URL=
STRAPI_EVENTS_API_ENABLED=false

# --- DigitalOcean Spaces (S3-compatible uploads) -----------------------------
# ⚠️ ONE SHARED MULTI-TENANT BUCKET across Caravea sites. Production writes under
# the `nobettertime` root path. Staging MUST NOT reuse that prefix, or staging
# uploads and deletes hit production media. Either give staging its own prefix
# (e.g. nobettertime-staging) or leave DO_SPACE_ENDPOINT blank to fall back to
# local-disk uploads.
# Endpoint is the REGIONAL host only — no bucket, no path suffix.
DO_SPACE_ENDPOINT=https://syd1.digitaloceanspaces.com
DO_SPACE_REGION=syd1
DO_SPACE_BUCKET=media-caravea
DO_SPACE_ROOT_PATH=<nobettertime prod | nobettertime-staging staging>
DO_SPACE_ACCESS_KEY=<from the DO Spaces key pair>
DO_SPACE_SECRET_KEY=<from the DO Spaces key pair>
# DO_SPACE_ACL=public-read
DO_SPACE_CDN_URL=

# ============================================================================
# NOT env-driven here, unlike most Caravea repos:
#
#   SMTP — lives in the Strapi "SMTP Settings" SINGLE TYPE, i.e. in the database.
#   That means `strapi transfer` CARRIES WORKING PRODUCTION MAIL CREDENTIALS into
#   whatever environment you transfer into. After any prod -> staging transfer,
#   open the staging admin and turn smtp_settings.enabled OFF before testing any
#   form, or staging submissions email the real inbox.
#
#   PUBLIC_URL — inert in this repo. config/server.ts has no `url:` key and nothing
#   in backend/config or backend/src reads it. Media works because Strapi returns
#   relative /uploads/... paths that the frontend prefixes with
#   NEXT_PUBLIC_STRAPI_URL. Setting it changes nothing.
#
#   REVALIDATE_URL / REVALIDATE_SECRET — no revalidate route exists in this repo.
# ============================================================================

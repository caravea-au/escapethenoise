# ============================================================================
# frontend/.env — lives at /home/ploi/<frontend-domain>/frontend/.env
#   staging: /home/ploi/staging.nobettertime.com.au/frontend/.env
#   prod:    /home/ploi/nobettertime.com.au/frontend/.env
# ----------------------------------------------------------------------------
# NOTE THE PATH: frontend/.env, not the repo root. That is where `next build` and
# `next start` read it from.
#
# Written over SSH by `/deployment`. NEVER committed, NEVER pasted into chat.
#
# This file must exist BEFORE the first `npm run build --workspace=frontend`.
# NEXT_PUBLIC_* values are INLINED into the build, so getting one wrong needs a
# rebuild, not a restart — and a plain rebuild is not enough either: the webpack
# cache under .next/cache holds the old value already inlined into cached modules
# (tell-tale: "Compiled successfully in ~3s"). To change a NEXT_PUBLIC_* value,
# `rm -rf frontend/.next` first, then rebuild. Verify with
#   grep -rc '<old-host>' frontend/.next/server
# ============================================================================

NODE_ENV=production

# Must be https end to end. This value also auto-allowlists the CMS host for
# next/image via next.config.ts images.remotePatterns.
NEXT_PUBLIC_STRAPI_URL=https://<staging-cms.nobettertime.com.au | cms.nobettertime.com.au>

# The DigitalOcean Spaces origin. next.config.ts only adds a host to
# images.remotePatterns IF its env var is set, so leaving this blank makes the
# next/image optimizer return 400 "url parameter is not allowed" for every Spaces
# image while the source files themselves still return 200 — images render broken
# for no visible reason. This one is read only by next.config.ts at boot, NOT
# inlined into any client bundle, so a `pm2 restart ... --update-env` is enough;
# no rebuild needed.
NEXT_PUBLIC_UPLOADS_URL=https://syd1.digitaloceanspaces.com

# Public Mapbox token for the /find-dealer map.
NEXT_PUBLIC_MAPBOX_TOKEN=<mapbox public token>

# ── Caravea Connect (REQUIRED for /find-dealer) ──────────────────────────────
# The dealer directory is read from Connect, not from Strapi. If these are
# missing the page renders its branded "can't load the dealer directory" panel
# and no dealers at all — there is no fallback source. Same pair as
# backend/.env. Neither is NEXT_PUBLIC_, so both are read at runtime: a
# `pm2 restart <name> --update-env` is enough, no rebuild needed.
# Values live in the Obsidian vault, never here.
CONNECT_API_URL=<https://staging-connect-v3.caravea.au | prod Connect base URL>
CONNECT_API_KEY=<X-Caravea-Key value>

# The Space dealer media is allowed to come from. Connect returns logo/photo
# URLs as plain strings that go into an <img src>, and syd1.digitaloceanspaces.com
# is DigitalOcean's shared regional endpoint, so bucket + root path are pinned
# as well. MUST match backend/.env on the same environment — a mismatch (e.g.
# `nobettertime` here against `nobettertime-staging` there) silently rejects
# every dealer image. Runtime-read, so no rebuild needed.
DO_SPACE_BUCKET=media-caravea
DO_SPACE_ROOT_PATH=<nobettertime prod | nobettertime-staging staging>

# Created in the CMS admin AFTER first boot: Settings > API Tokens > custom,
# read-only, scoped. Never "Full access", never unlimited lifespan. Leave blank on
# the very first deploy, then fill it in and restart with --update-env.
STRAPI_API_TOKEN=

# ── Caravea Connect push receiver (ETN-018) ──────────────────────────────────
# Shared secret for POST /api/connect/sync, which Connect calls when a dealer is
# approved, suspended, or their Company Information is saved. MUST be the exact
# value Connect holds as NOBETTERTIME_SYNC_SECRET for this environment (vault).
# Until it is set the route 401s every delivery and the push channel stays
# dormant; the pull sweep keeps the directory fresh on its own schedule either
# way. Runtime-read, so a `pm2 restart <name> --update-env` is enough.
# Optional: CONNECT_SYNC_CLOCK_TOLERANCE_SECONDS (default 900) tunes the
# timestamp freshness window.
CONNECT_SYNC_SECRET=

# Dedicated Strapi token for the sweep trigger the receiver fires after a
# verified delivery (pushes directory freshness from minutes to seconds).
# Create in CMS admin > Settings > API Tokens > custom, and grant ONLY the
# action api::integration.integration.syncDealers. NEVER full access, and NEVER
# the value of STRAPI_API_TOKEN above: that one stays read-only and is only a
# fallback the receiver knows will 401 against this write route. Unset or wrong
# scope = the trigger 401s and degrades silently (route still answers 200 and
# still invalidates the cache; the sweep keeps running on its own schedule).
# Runtime-read, so a `pm2 restart <name> --update-env` is enough.
CONNECT_SYNC_STRAPI_TOKEN=
